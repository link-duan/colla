{
  "name": "colla-ot",
  "version": "0.4.0",
  "description": "JavaScript and WebAssembly bindings for Colla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-duan/colla.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js",
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm build && pnpm exec tsc -p tsconfig.json --noEmit",
    "measure": "node scripts/measure.mjs",
    "test": "pnpm build && node --test --test-concurrency=1 tests/runtime.mjs tests/golden.test.mjs tests/node-tracer.mjs tests/bundlers.mjs && pnpm test:memory",
    "test:e2e": "node e2e/run.mjs",
    "prepack": "pnpm build",
    "test:memory": "node --expose-gc tests/memory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/node": "^26.6.4",
    "rollup": "^4.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
