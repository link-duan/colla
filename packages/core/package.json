{
  "name": "colla-ot",
  "version": "0.3.0",
  "description": "JavaScript and WebAssembly bindings for Colla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-duan/colla.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js",
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm build && pnpm exec tsc -p tsconfig.json --noEmit",
    "measure": "node scripts/measure.mjs",
    "test": "pnpm build && node --test --test-concurrency=1 tests/node-tracer.mjs tests/edit-steps.mjs tests/bundlers.mjs tests/golden.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/node": "^24.0.0",
    "rollup": "^4.46.2",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "license": "MIT"
}
